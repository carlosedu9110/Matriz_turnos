# Configuración de la aplicación
APP_NAME="Matriz Turnos"
APP_ENV=development
DEBUG=true

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=matriz_user
DB_PASSWORD=change-me
DB_NAME=matriz_turnos
# Si se define DATABASE_URL, tiene prioridad sobre los campos DB_* anteriores.
# DATABASE_URL=mysql+pymysql://matriz_user:change-me@localhost:3306/matriz_turnos

# Seguridad / JWT
SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Solo se usan para crear el primer usuario Admin. Cambiar antes del primer init_db.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-initial-admin-password

# Correo para invitaciones y recuperación de contraseña.
# "console" imprime los enlaces en la consola del servidor (solo desarrollo).
# En producción usa "smtp" y configura las credenciales de tu proveedor.
FRONTEND_BASE_URL=http://localhost:8000
EMAIL_BACKEND=console
RESET_TOKEN_EXPIRE_MINUTES=60
INVITE_TOKEN_EXPIRE_HOURS=72
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@matriz-turnos.local
SMTP_STARTTLS=true

# CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
