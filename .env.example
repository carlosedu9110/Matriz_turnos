# Configuración de la aplicación
APP_NAME="Matriz Turnos"
APP_ENV=development
DEBUG=true

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=matriz_user
DB_PASSWORD=change-me
DB_NAME=matriz_turnos
# Si se define DATABASE_URL, tiene prioridad sobre los campos DB_* anteriores.
# DATABASE_URL=mysql+pymysql://matriz_user:change-me@localhost:3306/matriz_turnos

# Seguridad / JWT
SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
